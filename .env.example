# Copy this file to .env (same folder) and fill it in. .env is ignored by git,
# so private values here never end up on GitHub.

# Fallback observer location (decimal degrees), used until the GPS has a fix.
# North and east are positive; south and west are negative.
DEFAULT_LATITUDE=
DEFAULT_LONGITUDE=

# true = run without the Pi hardware (simulated MCU, no GPS) for development.
SIMULATE_HARDWARE=false
